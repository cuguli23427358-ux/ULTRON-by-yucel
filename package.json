{
  "name": "ultron-orb-ui",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gateway:start": "node scripts/gateway.cjs",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --win",
    "desktop:public": "node scripts/build-public.cjs",
    "desktop:bundled": "node scripts/build-bundled.cjs",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "chrono-node": "^2.10.3",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.ultron.orb",
    "productName": "ULTRON",
    "fileAssociations": [
      {
        "ext": "ultron",
        "name": "ULTRON Encrypted API Keys",
        "role": "Viewer"
      }
    ],
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/**/*",
      "!.next/cache/**/*",
      "!.next/dev/**/*",
      "!.next/standalone/**/*",
      ".env.example",
      "electron/**/*",
      "public/**/*",
      "next.config.ts",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ULTRON"
    }
  }
}
