# Copy this file to .env.local and fill in your key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Free-tier Groq key for desktop speech recognition (https://console.groq.com/keys)
GROQ_API_KEY=
